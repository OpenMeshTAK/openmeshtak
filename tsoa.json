{
  "entryFile": "src/app.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/modules/**/*.controller.ts"],
  "spec": {
    "basePath": "/api/v1",
    "name": "OpenMeshTak Core API",
    "description": "Authoritative API for OpenMeshTak provisioning and mission distribution.",
    "license": "AGPL-3.0-only",
    "outputDirectory": "openapi",
    "specFileBaseName": "openapi",
    "specVersion": 3,
    "securityDefinitions": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "openmeshtak.session_token"
      }
    },
    "rootSecurity": [{ "sessionCookie": [] }],
    "version": "0.1.0"
  },
  "routes": {
    "authenticationModule": "src/shared/auth/authorization.ts",
    "basePath": "/api/v1",
    "esm": true,
    "middleware": "express",
    "routesDir": "src/generated"
  }
}
