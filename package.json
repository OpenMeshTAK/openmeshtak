{
  "name": "openmeshtak",
  "version": "0.2.2",
  "private": true,
  "description": "OpenMeshTak Core API server",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.12.0"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma"
    ],
    "overrides": {
      "deepmerge-ts": "8.0.0",
      "mysql2": "3.23.1",
      "ts-deepmerge": "8.0.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv"
      ]
    }
  },
  "scripts": {
    "build": "pnpm generate && tsc -p tsconfig.build.json",
    "check": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm license:check",
    "db:deploy": "tsx scripts/prepare-data.ts && tsx scripts/run-prisma.ts migrate deploy",
    "db:generate": "prisma generate --no-hints",
    "db:migrate": "tsx scripts/prepare-data.ts && tsx scripts/run-prisma.ts migrate dev",
    "db:status": "tsx scripts/run-prisma.ts migrate status",
    "dev": "pnpm generate && tsx watch src/server.ts",
    "generate": "prisma generate --no-hints && tsoa spec-and-routes",
    "license:check": "tsx scripts/check-licenses.ts",
    "release:notices": "tsx scripts/write-release-notices.ts",
    "lint": "eslint . --max-warnings 0",
    "smoke:clean-install": "pnpm build && tsx scripts/smoke-clean-install.ts",
    "start": "node dist/server.js",
    "test": "pnpm generate && tsx scripts/run-tests.ts",
    "typecheck": "pnpm generate && tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.7",
    "@better-auth/prisma-adapter": "1.7.7",
    "@bufbuild/protobuf": "2.16.0",
    "@meshtastic/protobufs": "jsr:2.8.1",
    "@peculiar/x509": "2.1.0",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@simplewebauthn/server": "13.3.3",
    "@tsoa/runtime": "6.6.0",
    "@turf/circle": "7.4.0",
    "@turf/kinks": "7.4.0",
    "acme-client": "5.4.0",
    "better-auth": "1.7.7",
    "better-sqlite3": "13.0.3",
    "dotenv": "18.0.5",
    "express": "4.22.3",
    "express-rate-limit": "8.7.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "node-forge": "1.4.0",
    "nodemailer": "10.0.15",
    "pino": "10.4.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "socket.io": "4.8.4",
    "swagger-ui-express": "5.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "4.17.25",
    "@types/node": "24.19.0",
    "@types/node-forge": "1.3.14",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "auth": "1.7.7",
    "eslint": "10.12.0",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.1",
    "tsoa": "6.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
