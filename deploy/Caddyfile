# Public HTTPS in front of OpenMeshTak. Caddy obtains and renews the Let's Encrypt certificate for
# PUBLIC_HOST and forwards everything to Core, which serves both the Web app and the API with their
# security headers. Core's TAK ports are published by the Core container directly.
#
# Behind another reverse proxy that already terminates HTTPS (e.g. CloudPanel/nginx), set
# SITE_ADDRESS=:80 so Caddy serves plain HTTP inside the network and trusts forwarded headers.
# Otherwise SITE_ADDRESS is the public host name (compose sets it from PUBLIC_HOST).
{
	servers {
		trusted_proxies static private_ranges
	}
}

{$SITE_ADDRESS} {
	encode zstd gzip
	reverse_proxy {$CORE_ADDRESS:core:3000}
}
