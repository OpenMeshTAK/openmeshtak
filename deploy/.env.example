# Release of the OpenMeshTak image (Core with the Web app), e.g. 0.2.0.
OPENMESHTAK_VERSION=0.1.0
# Public host name of the Web app; DNS must point here so Caddy can obtain a certificate.
PUBLIC_HOST=openmeshtak.example.org
# At least 32 random characters, e.g. from: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-long-random-value
LOG_LEVEL=info
# Swagger UI at https://<PUBLIC_HOST>/api/docs; off by default in production.
SWAGGER_ENABLED=false
