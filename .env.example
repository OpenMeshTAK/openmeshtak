NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
DATABASE_URL=file:./server/data/db/openmeshtak.sqlite
# Required in production: a file outside /server/data, such as /run/secrets/openmeshtak_root_key,
# holding 32 random bytes as base64 (openssl rand -base64 32). It also derives the session signing
# key. Without it, development creates server/secrets/root-encryption.key on first use.
# ROOT_ENCRYPTION_KEY_FILE=
BOOTSTRAP_TOKEN_TTL_MINUTES=15
LOG_LEVEL=info
# Swagger UI at /api/docs (the OpenAPI document stays at /api/openapi.json). Defaults to true in
# development and false in production.
SWAGGER_ENABLED=true
# true behind exactly one reverse proxy that alone can reach Core: the client address is then the
# last X-Forwarded-For entry, the one the proxy adds.
TRUST_PROXY=false
