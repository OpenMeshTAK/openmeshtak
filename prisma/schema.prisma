generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum EventStatus {
  draft
  active
  archived
}

model Event {
  id                      String                       @id
  name                    String
  slug                    String                       @unique
  timeZone                String
  status                  EventStatus                  @default(draft)
  version                 Int                          @default(1)
  startsAt                DateTime?
  endsAt                  DateTime?
  /// Days a TAK login token stays valid; 0 keeps it valid until the event's end date, or with no end date it never expires.
  takLoginTokenDays       Int                          @default(0)
  /// Accounts created for this event are permanent instead of being deleted when it is archived.
  permanentAccounts       Boolean                      @default(false)
  /// The event provisions Meshtastic radios. Off for TAK-only events; channels and radio settings
  /// stay stored while it is off but are left out of revisions, profiles and downloads.
  meshtasticEnabled       Boolean                      @default(false)
  createdAt              DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  permissionGrants        PermissionGrant[]
  apiClientGrants         ApiClientPermissionGrant[]
  roles                   EventRole[]
  groups                  EventGroup[]
  takTrafficRecording     TakTrafficRecording?
  takTrafficItems         TakTrafficItem[]
  members                 EventMember[]
  syncIssues              SyncIssue[]
  memberClaims            MemberClaim[]
  configurationRevisions  EventConfigurationRevision[]
  dataPackages            DataPackage[]
  meshtasticChannels      MeshtasticChannel[]
  meshtasticConfiguration MeshtasticConfiguration?
  takConfiguration        TakConfiguration?
  takGroups               TakGroup[]
  atakPreferenceList      AtakPreferenceList?
  atakPreferences         AtakPreferenceEntry[]
  /// Event accounts; archiving the event deletes them.
  accounts                DomainUser[]                 @relation("EventAccounts")
}

model User {
  id              String      @id
  name            String
  email           String      @unique
  emailVerified   Boolean     @default(false)
  /// Lowercase sign-in and TAK login name (Better Auth username plugin). Set for every account.
  username        String?     @unique
  displayUsername String?
  image           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sessions        Session[]
  accounts        Account[]
  passkeys        Passkey[]
  domainUser      DomainUser?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// WebAuthn credential owned by Better Auth's passkey plugin. Holds only the public key.
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  aaguid       String?
  createdAt    DateTime? @default(now())

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model DomainUser {
  id                    String                 @id
  displayName           String
  /// Set while an administrator has disabled the account: no sign-in, no sessions, no TAK access.
  disabledAt            DateTime?
  version               Int                    @default(1)
  authSubjectId         String?                @unique
  authSubject           User?                  @relation(fields: [authSubjectId], references: [id], onDelete: SetNull)
  /// Set for event accounts: archiving this event deletes the account. `null` for permanent accounts.
  accountEventId        String?
  accountEvent          Event?                 @relation("EventAccounts", fields: [accountEventId], references: [id], onDelete: Restrict)
  memberships           UserGroupMembership[]
  createdApiClients     ApiClient[]
  createdApiKeys        ApiKey[]
  externalIdentities    ExternalIdentity[]
  eventMemberships      EventMember[]
  takEnrollmentTokens   TakEnrollmentToken[]
  takClientCertificates TakClientCertificate[]
  downloadGrants        DownloadGrant[]
  accountInvites        AccountInvite[]
  missionSubscriptions  MissionSubscription[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([accountEventId])
}

/// Authorization group. `systemKey` marks groups the server protects, such as the setup Admin group.
model UserGroup {
  id               String                @id
  name             String
  slug             String                @unique
  systemKey        String?               @unique
  version          Int                   @default(1)
  memberships      UserGroupMembership[]
  permissionGrants PermissionGrant[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model UserGroupMembership {
  userId      String
  userGroupId String
  user        DomainUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userGroup   UserGroup  @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  assignedAt  DateTime   @default(now())

  @@id([userId, userGroupId])
  @@index([userGroupId])
}

model PermissionGrant {
  id          String    @id
  userGroupId String
  permission  String
  scopeKey    String
  eventId     String?
  userGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userGroupId, permission, scopeKey])
  @@index([eventId])
}

model BootstrapChallenge {
  id         String    @id
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

enum ApiClientStatus {
  active
  disabled
}

/// A non-human machine principal. It is intentionally not a User and cannot join user groups.
model ApiClient {
  id               String                     @id
  name             String
  description      String?
  status           ApiClientStatus            @default(active)
  version          Int                        @default(1)
  createdByUserId  String?
  createdBy        DomainUser?                @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  permissionGrants ApiClientPermissionGrant[]
  apiKeys          ApiKey[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([createdAt, id])
}

model ApiClientPermissionGrant {
  id          String    @id
  apiClientId String
  permission  String
  scopeKey    String
  eventId     String?
  apiClient   ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([apiClientId, permission, scopeKey])
  @@index([eventId])
}

/// Stores only safe metadata and a SHA-256 digest of the random key secret, never the bearer value.
model ApiKey {
  id              String      @id
  apiClientId     String
  name            String
  publicKeyId     String      @unique
  secretHash      String
  expiresAt       DateTime?
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  apiClient       ApiClient   @relation(fields: [apiClientId], references: [id], onDelete: Cascade)
  createdBy       DomainUser? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())

  @@index([apiClientId, createdAt, id])
}

enum AuditActorType {
  user
  api_client
  anonymous
  system
}

enum AuditResult {
  success
  failure
}

/// Append-only record of security-relevant actions. Never store secrets or their hashes here.
model AuditEvent {
  id         String         @id
  occurredAt DateTime       @default(now())
  actorType  AuditActorType
  actorId    String?
  action     String
  targetType String
  targetId   String?
  result     AuditResult
  traceId    String?
  metadata   Json?

  @@index([occurredAt, id])
  @@index([targetType, targetId])
}

/// Event-owned participant role such as `participant`. Never an authorization group.
model EventRole {
  id                String                      @id
  eventId           String
  name              String
  slug              String
  description       String?
  /// Optional ATAK role that replaces the event group's default TAK role for members of this role.
  takRoleOverride   String?
  /// Members of this role see and reach every event group when the event separates TAK groups.
  seesAllTakGroups  Boolean                     @default(false)
  version           Int                         @default(1)
  event             Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members           EventMember[]
  channelSelections MeshtasticChannelAudience[]
  packageSelections DataPackageAudience[]
  missionWriterSelections DataPackageWriter[]
  atakPreferences   AtakPreferenceEntry[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([eventId, slug])
  @@index([eventId, createdAt, id])
}

/// Event-owned tactical/provisioning group such as `bravo`. Never grants permissions.
model EventGroup {
  id                String                      @id
  eventId           String
  name              String
  slug              String
  description       String?
  version           Int                         @default(1)
  /// Template such as `{username} [Bravo]`; validated against an allowlist of placeholders.
  callsignFormat    String                      @default("{username}")
  /// Meshtastic short-name prefix such as `B`; null until an administrator chooses a free one.
  shortNamePrefix   String?
  takTeam           String                      @default("Cyan")
  takRole           String                      @default("Team Member")
  /// Validated JSON string arrays.
  takServerGroups   Json                        @default("[]")
  event             Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members           EventMember[]
  channelSelections MeshtasticChannelAudience[]
  packageSelections DataPackageAudience[]
  missionWriterSelections DataPackageWriter[]
  atakPreferences   AtakPreferenceEntry[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([eventId, slug])
  @@unique([eventId, shortNamePrefix])
  @@index([eventId, createdAt, id])
}

/// Provider-neutral external identifier such as a Discord user ID. Never a login method.
model ExternalIdentity {
  id         String     @id
  provider   String
  externalId String
  /// Username last reported by the integration; untrusted display data.
  username   String
  userId     String
  user       DomainUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([provider, externalId])
  @@index([userId])
}

/// Participation of one user in one event with exactly one event role and one event group.
model EventMember {
  id                String                      @id
  eventId           String
  userId            String
  eventRoleId       String
  eventGroupId      String
  version           Int                         @default(1)
  /// Name reported for this event by the integration; untrusted display data used in callsigns.
  username          String
  /// Effective callsign (override or rendered group format), unique within the event.
  callsign          String
  callsignOverride  String?
  /// Stable per-group number behind Meshtastic short names such as `B1`.
  shortNameNumber   Int
  event             Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user              DomainUser                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: assigned roles and groups cannot be deleted until members are reassigned.
  eventRole         EventRole                   @relation(fields: [eventRoleId], references: [id], onDelete: Restrict)
  eventGroup        EventGroup                  @relation(fields: [eventGroupId], references: [id], onDelete: Restrict)
  claims            MemberClaim[]
  channelSelections MeshtasticChannelAudience[]
  packageSelections DataPackageAudience[]
  missionWriterSelections DataPackageWriter[]
  takGroups         TakGroupMembership[]
  atakPreferences   AtakPreferenceEntry[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([eventId, userId])
  @@unique([eventId, callsign])
  @@unique([eventGroupId, shortNameNumber])
  @@index([eventId, createdAt, id])
  @@index([eventRoleId])
}

enum SyncIssueStatus {
  open
  resolved
}

/// A synchronization that could not resolve exactly one event role and group. It carries no secrets.
model SyncIssue {
  id             String          @id
  eventId        String
  provider       String
  externalId     String
  status         SyncIssueStatus @default(open)
  username       String
  requestedRole  String
  requestedGroup String
  /// Validated list of { field, code, message } explaining why resolution failed.
  reasons        Json
  occurrences    Int             @default(1)
  resolvedAt     DateTime?
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([eventId, provider, externalId])
  @@index([eventId, createdAt, id])
}

/// Short-lived, single-use claim that lets a member establish a browser session. Only the SHA-256
/// digest of the random token is stored.
model MemberClaim {
  id           String      @id
  eventId      String
  memberId     String
  tokenHash    String      @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  revokedAt    DateTime?
  /// Safe actor reference ("user" or "api-client") of whoever issued the claim.
  issuedByType String
  issuedById   String
  event        Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member       EventMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([memberId])
  @@index([eventId])
}

/// Immutable snapshot of an event's roles and group provisioning settings. Profiles and generated
/// artifacts of active events refer to a revision so their inputs stay reproducible.
model EventConfigurationRevision {
  id            String   @id
  eventId       String
  number        Int
  /// "activation", "reactivation" or "publish".
  reason        String
  /// Versioned snapshot document; never edited after creation.
  snapshot      Json
  /// SHA-256 of the canonical snapshot, used to skip publishing an unchanged configuration.
  snapshotHash  String
  createdByType String
  createdById   String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())

  @@unique([eventId, number])
  @@index([eventId, createdAt, id])
}

/// Editable, format-neutral map content of one event, distributed as an ATAK Data Package.
model DataPackage {
  id                  String                @id
  eventId             String
  name                String
  description         String?
  version             Int                   @default(1)
  /// Drawing order within the event; lower values are drawn first, below higher ones.
  sortOrder           Int                   @default(0)
  /// "package" (a Data Package published as revisions) or "mission" (an ATAK Data Sync mission whose
  /// revisions are synced to subscribed TAK apps). Fixed at creation.
  kind                String                @default("package")
  /// Missions only: who may change the mission from a TAK app; empty means nobody.
  writers             DataPackageWriter[]
  /// Missions only: TAK apps that subscribed through Data Sync.
  subscriptions       MissionSubscription[]
  /// Distribution: every member of the event, or only the members the audience selects.
  audienceAll         Boolean               @default(true)
  audience            DataPackageAudience[]
  /// The built-in TAK server installs the package right after a member enrolls.
  installOnEnrollment Boolean               @default(false)
  /// The built-in TAK server delivers new or changed revisions whenever a member connects.
  installOnConnection Boolean               @default(false)
  /// Cached SHA-256 of the draft snapshot; cleared on every draft change and recomputed on read.
  draftHash           String?
  event               Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  layers              PackageLayer[]
  objects             PackageObject[]
  contents            PackageContent[]
  revisions           PackageRevision[]
  sources             DataPackageSource[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([eventId, createdAt, id])
}

/// Immutable provenance for content copied from a published Data Package revision. Source fields
/// are deliberately snapshots rather than relations, so deleting the source does not erase history.
model DataPackageSource {
  id                 String      @id
  packageId          String
  sourcePackageId    String
  sourcePackageName  String
  sourceRevision     Int
  sourceSnapshotHash String
  sourceLayerIds     Json
  dataPackage        DataPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt          DateTime    @default(now())

  @@index([packageId])
}

model PackageLayer {
  id          String           @id
  packageId   String
  name        String
  /// Drawing and export order; lower values are drawn first.
  sortOrder   Int
  visible     Boolean          @default(true)
  locked      Boolean          @default(false)
  version     Int              @default(1)
  dataPackage DataPackage      @relation(fields: [packageId], references: [id], onDelete: Cascade)
  objects     PackageObject[]
  contents    PackageContent[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([packageId, sortOrder])
}

/// Immutable bytes kept outside the Web root under the generated `storageKey`.
model StorageBlob {
  id              String           @id
  storageKey      String           @unique
  sha256          String
  size            Int
  mediaType       String
  packageContents PackageContent[]
  iconSettings    IconSettings[]
  createdAt       DateTime         @default(now())

  @@index([sha256])
}

/// One opaque file retained from an imported ATAK Data Package and assigned to its target layer.
model PackageContent {
  id          String       @id
  packageId   String
  layerId     String
  blobId      String
  kind        String
  name        String
  archivePath String
  /// Kind-specific display data, such as a rubber sheet's corners; never needed to export.
  metadata    Json?
  /// Editor display only, like layer visibility; the exported file is always unchanged.
  visible     Boolean      @default(true)
  /// Editor display opacity from 0 to 1.
  opacity     Float        @default(1)
  version     Int          @default(1)
  dataPackage DataPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  layer       PackageLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  blob        StorageBlob  @relation(fields: [blobId], references: [id], onDelete: Restrict)
  createdAt   DateTime     @default(now())

  @@index([packageId, createdAt, id])
  @@index([layerId])
  @@index([blobId])
}

/// One point, line, polygon or circle. Geometry is validated RFC 7946 GeoJSON in WGS84.
model PackageObject {
  id          String       @id
  packageId   String
  layerId     String
  /// "point", "line", "polygon" or "circle"; mirrors the geometry type for filtering.
  kind        String
  geometry    Json
  name        String
  description String?
  style       Json
  /// Optional TAK marker metadata (CoT type, icon set path); markers only.
  tak         Json?
  version     Int          @default(1)
  dataPackage DataPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  layer       PackageLayer @relation(fields: [layerId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([packageId, createdAt, id])
  @@index([layerId])
}

/// Immutable published state of a data package; distribution uses a revision, never the draft.
model PackageRevision {
  id            String      @id
  packageId     String
  number        Int
  snapshot      Json
  snapshotHash  String
  /// Estimated ATAK download size in bytes, stored at publish; null on revisions published before it.
  exportSize    Int?
  createdByType String
  createdById   String
  dataPackage   DataPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([packageId, number])
  @@index([packageId, createdAt, id])
}

/// Meshtastic channel of an event. The lowest `sortOrder` is the primary channel and reaches every
/// member; secondary channels reach only their audience.
model MeshtasticChannel {
  id                String                      @id
  eventId           String
  /// At most 11 bytes (upstream limit), unique within the event.
  name              String
  sortOrder         Int
  /// Secret-box envelope of the PSK; never returned by normal responses.
  pskEnvelope       String
  /// Plain PSK length (0, 1, 16 or 32) so responses can describe the key without decrypting it.
  pskBytes          Int
  /// Incremented on every rotation so revisions and artifacts can tell which key they used.
  pskVersion        Int                         @default(1)
  pskRotatedAt      DateTime?
  uplinkEnabled     Boolean                     @default(false)
  downlinkEnabled   Boolean                     @default(false)
  /// Upstream `ModuleSettings.position_precision`: 0 sends no position, 32 full precision.
  positionPrecision Int                         @default(0)
  /// Secret channels withhold the PSK from everyone except key holders until `releasedAt`.
  secret            Boolean                     @default(false)
  releasedAt        DateTime?
  version           Int                         @default(1)
  event             Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  audience          MeshtasticChannelAudience[]
  takConfigurations TakConfiguration[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@unique([eventId, name])
  @@index([eventId, createdAt, id])
}

/// One selector of a channel: exactly one of group, role or member is set. `keyHolder` rows select
/// the members of a secret channel who receive its key before release.
model MeshtasticChannelAudience {
  id            String            @id
  channelId     String
  keyHolder     Boolean           @default(false)
  eventGroupId  String?
  eventRoleId   String?
  eventMemberId String?
  channel       MeshtasticChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  eventGroup    EventGroup?       @relation(fields: [eventGroupId], references: [id], onDelete: Cascade)
  eventRole     EventRole?        @relation(fields: [eventRoleId], references: [id], onDelete: Cascade)
  eventMember   EventMember?      @relation(fields: [eventMemberId], references: [id], onDelete: Cascade)

  @@index([channelId])
  @@index([eventGroupId])
  @@index([eventRoleId])
  @@index([eventMemberId])
}

/// An event's recommended Meshtastic firmware and its radio settings. Missing for events that still
/// use the default firmware line and profile defaults.
model MeshtasticConfiguration {
  eventId         String   @id
  /// Line or line plus minimum patch, such as `2.8` or `2.8.3`; selects the firmware profile.
  firmwareVersion String
  /// Values of the profile's editable fields, keyed by field key and validated on every write.
  settings        Json
  /// Write-only secret field values (Wi-Fi password, MQTT password, ...) as one encrypted JSON
  /// envelope bound to the event. Never part of settings, snapshots or normal responses.
  secretsEnvelope String?
  version         Int      @default(1)
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// One audience selector of a Data Package: exactly one of group, role or member is set.
/// A TAK app subscribed to a mission through Data Sync; it receives every synced revision.
model MissionSubscription {
  id          String      @id
  packageId   String
  userId      String
  /// The subscribing app's device UID, which the streaming connection reports as its own position UID.
  clientUid   String
  /// Opaque value returned to the app like TAK Server's subscription token; access still comes from the client certificate.
  token       String
  dataPackage DataPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  user        DomainUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@unique([packageId, clientUid])
  @@index([clientUid])
}

/// Missions only: the groups, roles and members that may change the mission from a TAK app.
model DataPackageWriter {
  id            String       @id
  packageId     String
  eventGroupId  String?
  eventRoleId   String?
  eventMemberId String?
  dataPackage   DataPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  eventGroup    EventGroup?  @relation(fields: [eventGroupId], references: [id], onDelete: Cascade)
  eventRole     EventRole?   @relation(fields: [eventRoleId], references: [id], onDelete: Cascade)
  eventMember   EventMember? @relation(fields: [eventMemberId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([eventGroupId])
  @@index([eventRoleId])
  @@index([eventMemberId])
}

model DataPackageAudience {
  id            String       @id
  packageId     String
  eventGroupId  String?
  eventRoleId   String?
  eventMemberId String?
  dataPackage   DataPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  eventGroup    EventGroup?  @relation(fields: [eventGroupId], references: [id], onDelete: Cascade)
  eventRole     EventRole?   @relation(fields: [eventRoleId], references: [id], onDelete: Cascade)
  eventMember   EventMember? @relation(fields: [eventMemberId], references: [id], onDelete: Cascade)

  @@index([packageId])
  @@index([eventGroupId])
  @@index([eventRoleId])
  @@index([eventMemberId])
}

/// TAK connection details of a Meshtastic event. Whether TAK clients use the Meshtastic app's local
/// TAK server or the built-in server follows `Event.meshtasticEnabled`; here only the mesh channel
/// the app carries CoT over is chosen.
model TakConfiguration {
  eventId       String             @id
  /// Channel the app's "TAK Mesh Channel" should use; null means the primary channel.
  meshChannelId          String?
  /// "off" (the event is the only CoT boundary), "simple" (members only see their event group) or
  /// "advanced" (free TAK groups with in/out membership per member).
  groupMode              String             @default("off")
  /// In advanced mode, TAK apps list their groups and may switch them on and off.
  groupsInApp            Boolean            @default(false)
  version                Int                @default(1)
  event                  Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  meshChannel            MeshtasticChannel? @relation(fields: [meshChannelId], references: [id], onDelete: SetNull)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

/// Version of an event's ATAK preference list, which is saved as a whole.
model AtakPreferenceList {
  eventId   String   @id
  version   Int      @default(1)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One ATAK preference an event sends to the whole event or to one event group, role or member.
model AtakPreferenceEntry {
  id            String       @id
  eventId       String
  /// `event`, `group:<id>`, `role:<id>` or `member:<id>`, so a key is unique per target.
  targetKey     String
  eventGroupId  String?
  eventRoleId   String?
  eventMemberId String?
  /// The `<preference name>` group, such as `com.atakmap.app_preferences`.
  preference    String
  key           String
  /// `string`, `boolean`, `integer`, `long` or `float`.
  type          String
  value         String
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventGroup    EventGroup?  @relation(fields: [eventGroupId], references: [id], onDelete: Cascade)
  eventRole     EventRole?   @relation(fields: [eventRoleId], references: [id], onDelete: Cascade)
  eventMember   EventMember? @relation(fields: [eventMemberId], references: [id], onDelete: Cascade)

  @@unique([eventId, targetKey, preference, key])
  @@index([eventGroupId])
  @@index([eventRoleId])
  @@index([eventMemberId])
}

/// A free TAK group of an event for the advanced group mode, e.g. "Medics".
model TakGroup {
  id          String               @id
  eventId     String
  name        String
  description String?
  version     Int                  @default(1)
  event       Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members     TakGroupMembership[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([eventId, name])
}

/// Whether a member receives the group's traffic (in) and sends into the group (out).
model TakGroupMembership {
  groupId  String
  memberId String
  receive  Boolean
  send     Boolean
  group    TakGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member   EventMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([groupId, memberId])
  @@index([memberId])
}

/// Certificate authorities of the built-in TAK server. The active one signs new certificates;
/// older ones stay trusted until they expire so issued client certificates keep working.
model TakCertificateAuthority {
  id                String   @id
  /// "generated" by OpenMeshTak or "imported" by an administrator.
  origin            String
  certificatePem    String
  /// PKCS#8 private key, encrypted with the deployment root key and bound to this row.
  keyEnvelope       String
  fingerprintSha256 String   @unique
  subject           String
  notBefore         DateTime
  notAfter          DateTime
  /// "active" on exactly one row; the unique constraint makes a concurrent second CA impossible.
  activeSlot        String?  @unique
  createdAt         DateTime @default(now())
}

/// The TLS certificate the TAK listeners present: issued by the OpenMeshTak CA, or added by an
/// administrator as a publicly trusted certificate such as Let's Encrypt.
model TakServerCertificate {
  id                  String   @id
  /// "issued" by OpenMeshTak, "added" by an administrator or obtained through "acme".
  source              String
  hostName            String
  /// CA that issued it; null for added certificates.
  caId                String?
  /// Leaf first, then intermediates (and the OpenMeshTak CA for issued certificates).
  certificateChainPem String
  /// PKCS#8 private key, encrypted with the deployment root key and bound to this row.
  keyEnvelope         String
  fingerprintSha256   String
  subject             String
  notAfter            DateTime
  /// "active" on exactly one row.
  activeSlot          String?  @unique
  /// When administrators were last warned that this certificate is about to expire.
  expiryWarningSentAt DateTime?
  createdAt           DateTime @default(now())
}

/// Automatic public certificate issuance for the TAK listeners. Provider credentials and the
/// ACME account key are encrypted with the deployment root key and never returned by the API.
model TakAcmeSettings {
  id                 String    @id
  enabled            Boolean   @default(false)
  email              String?
  challengeType      String    @default("dns-01")
  provider           String    @default("cloudflare")
  cloudflareZoneId   String?
  apiTokenEnvelope   String?
  accountKeyEnvelope String?
  lastAttemptAt      DateTime?
  lastSuccessAt      DateTime?
  lastError          String?
  version            Int       @default(1)
  updatedAt          DateTime  @updatedAt
}

/// Installation-wide settings of the built-in TAK server; a single row with id "tak-server".
model TakServerSettings {
  id                    String   @id
  enabled               Boolean  @default(false)
  /// Public host name or IP address clients connect to; required before the server can start.
  hostName              String?
  enrollmentPort        Int      @default(8446)
  martiPort             Int      @default(8443)
  streamingPort         Int      @default(8089)
  clientCertificateDays Int      @default(365)
  /// Hours after which a downloaded iTAK or WinTAK package that never connected is revoked.
  unusedPackageHours    Int      @default(24)
  /// When the public host name or a public port last changed after setup. Apps enrolled before it
  /// may still use the old endpoint and must enroll again.
  endpointChangedAt     DateTime?
  /// Server certificate files of the reverse proxy, relative to TAK_CERTIFICATE_DIRECTORY; null
  /// unless the certificate source is the proxy's files. Core reloads them when they change.
  certificateFile       String?
  certificateKeyFile    String?
  version               Int      @default(1)
  updatedAt             DateTime @updatedAt
}

/// TAK login token: the app sends it with the username instead of the account password, from the
/// ATAK QR code or typed by hand. Only the SHA-256 hash is stored.
model TakEnrollmentToken {
  id        String     @id
  userId    String
  tokenHash String     @unique
  /// null: valid without a time limit, as long as the user keeps TAK access.
  expiresAt DateTime?
  usedAt    DateTime?
  user      DomainUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([userId])
}

/// Client certificate signed for a TAK app. Connections are accepted only while it is not revoked
/// and its user still has TAK access.
model TakClientCertificate {
  id                String     @id
  userId            String
  caId              String
  serialNumber      String     @unique
  fingerprintSha256 String     @unique
  commonName        String
  /// Device UID the app sent during enrollment, if any.
  clientUid         String?
  /// First and latest streaming connection with this certificate; an iTAK or WinTAK package that
  /// never connects is revoked after the configured number of hours.
  firstConnectedAt  DateTime?
  lastConnectedAt   DateTime?
  /// What the app reports about itself in its own position beacon (`takv` and `contact`); set by
  /// the app, so it names the device but proves nothing.
  deviceName        String?
  deviceApp         String?
  deviceAppVersion  String?
  deviceOs          String?
  deviceCallsign    String?
  notBefore         DateTime
  notAfter          DateTime
  revokedAt         DateTime?
  revocationReason  String?
  user              DomainUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime   @default(now())

  @@index([userId])
}

/// SMTP delivery for account emails; a single row with id "email". The password is write-only.
model EmailSettings {
  id               String   @id
  enabled          Boolean  @default(false)
  host             String?
  port             Int      @default(587)
  /// "starttls", "tls" (implicit TLS) or "none" (only for local relays).
  security         String   @default("starttls")
  username         String?
  /// Encrypted with the deployment root key; never returned.
  passwordEnvelope String?
  fromAddress      String?
  fromName         String   @default("OpenMeshTak")
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt
}

/// Opt-in recording of an event's TAK traffic. Off by default, because positions are personal data.
model TakTrafficRecording {
  eventId       String   @id
  enabled       Boolean  @default(false)
  /// Recorded items older than this are deleted by the daily cleanup.
  retentionDays Int      @default(30)
  version       Int      @default(1)
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  updatedAt     DateTime @updatedAt
}

/// One recorded CoT state (position or marker) of an event, kept for the retention period.
model TakTrafficItem {
  id           String   @id
  eventId      String
  uid          String
  type         String
  callsign     String?
  lat          Float
  lon          Float
  time         DateTime
  stale        DateTime
  /// CoT `how`, e.g. `m-g` (machine GPS) or `h-e` (human estimate); null for items recorded before it was kept.
  how          String?
  /// Circular error in metres from `point/ce`; null when unknown (TAK sends 9999999 for unknown).
  ce           Float?
  /// The sending app's own position beacon rather than a marker it placed; false for older items.
  selfReported Boolean  @default(false)
  /// The OpenMeshTak user whose TAK app sent it.
  userId       String
  receivedAt   DateTime @default(now())
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, receivedAt])
  @@index([eventId, time])
}

/// Instance-wide display settings; a single row with id "instance". A missing row means the
/// default name "OpenMeshTak".
model InstanceSettings {
  id        String   @id
  /// Shown as the browser page title, on the sign-in page and in account emails.
  name      String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

/// Whether Core looks up published Meshtastic firmware releases from the official flasher; a single
/// row with id "meshtastic". Defaults to on; offline installations switch it off.
model FirmwareReleaseSettings {
  id           String   @id
  checkEnabled Boolean  @default(true)
  version      Int      @default(1)
  updatedAt    DateTime @updatedAt
}

/// The Web editor's online base maps; a single row with id "map". Legacy fields mirror the default.
model MapSettings {
  id              String   @id
  providerName    String
  /// XYZ tile URL with {z}, {x} and {y}, e.g. https://tile.openstreetmap.org/{z}/{x}/{y}.png
  tileUrlTemplate String
  /// Plain-text attribution the provider requires, shown on every map.
  attribution     String
  maxZoom         Int      @default(19)
  /// Validated BaseMapLayerDto[]; null upgrades the existing single provider on read.
  layers          Json?
  defaultLayerId  String?
  version         Int      @default(1)
  updatedAt       DateTime @updatedAt
}

/// Operator-provided icons shared by all Web editors; a singleton row with id "icons".
model IconSettings {
  id        String       @id
  blobId    String?
  /// Validated TAK paths and PNG metadata; the original SQLite database is discarded.
  icons     Json
  version   Int          @default(1)
  updatedAt DateTime     @updatedAt
  blob      StorageBlob? @relation(fields: [blobId], references: [id], onDelete: Restrict)

  @@index([blobId])
}

/// Single-use link onto the instance; only the hash of its token is stored. With `userId` it is a
/// setup link: it signs in that administrator-created user, who then picks a password. Without
/// `userId` it is a registration invite that allows one sign-up while registration is invite-only.
model AccountInvite {
  id           String      @id
  userId       String?
  tokenHash    String      @unique
  expiresAt    DateTime
  consumedAt   DateTime?
  revokedAt    DateTime?
  /// Safe actor reference ("user" or "api-client") of whoever issued the link.
  issuedByType String
  issuedById   String
  user         DomainUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime    @default(now())

  @@index([userId])
}

/// Whether people may create their own account. A missing row means "closed".
model RegistrationSettings {
  id        String   @id
  /// "closed", "invite" (needs a registration invite) or "open".
  mode      String
  version   Int      @default(1)
  updatedAt DateTime @updatedAt
}

/// Result of a POST sent with an `Idempotency-Key`, so a retry returns the original response
/// instead of repeating the work. Kept for 24 hours; only routes without secrets in their response
/// use it.
model IdempotencyRecord {
  id                  String   @id
  /// Safe actor reference ("user" or "api-client") of the caller the key belongs to.
  principalType       String
  principalId         String
  path                String
  key                 String
  /// SHA-256 of the canonical query and body; a different request with the same key is refused.
  requestHash         String
  /// Null while the first request is still running.
  responseStatus      Int?
  responseContentType String?
  responseBody        String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@unique([principalType, principalId, path, key])
  @@index([expiresAt])
}

/// Short-lived link to one generated artifact, so a phone can download it without a browser
/// session, e.g. after scanning a QR code. Only the hash of the link token is stored.
model DownloadGrant {
  id        String     @id
  tokenHash String     @unique
  /// The user the artifact is generated for and whose access is checked again on download.
  userId    String
  /// "device-profile", "member-data-package", "tak-connection-package", "itak-connection-package" or "wintak-connection-package".
  kind      String
  eventId   String?
  memberId  String?
  packageId String?
  expiresAt DateTime
  uses      Int        @default(0)
  user      DomainUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([userId])
}
