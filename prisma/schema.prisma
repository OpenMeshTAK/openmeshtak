generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum EventStatus {
  draft
  active
  archived
}

model Event {
  id                   String                          @id
  name                 String
  slug                 String                          @unique
  timeZone             String
  status               EventStatus                     @default(draft)
  version              Int                             @default(1)
  startsAt             DateTime?
  endsAt               DateTime?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  permissionGrants     PermissionGrant[]
  serviceAccountGrants ServiceAccountPermissionGrant[]
  roles                EventRole[]
  groups               EventGroup[]
  members              EventMember[]
  syncIssues           SyncIssue[]
}

model User {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  domainUser    DomainUser?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model DomainUser {
  id                     String                @id
  displayName            String
  authSubjectId          String?               @unique
  authSubject            User?                 @relation(fields: [authSubjectId], references: [id], onDelete: SetNull)
  memberships            UserGroupMembership[]
  createdServiceAccounts ServiceAccount[]
  createdApiKeys         ApiKey[]
  externalIdentities     ExternalIdentity[]
  eventMemberships       EventMember[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
}

/// Authorization group. `systemKey` marks groups the server protects, such as the setup Admin group.
model UserGroup {
  id               String                @id
  name             String
  slug             String                @unique
  systemKey        String?               @unique
  version          Int                   @default(1)
  memberships      UserGroupMembership[]
  permissionGrants PermissionGrant[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model UserGroupMembership {
  userId      String
  userGroupId String
  user        DomainUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userGroup   UserGroup  @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  assignedAt  DateTime   @default(now())

  @@id([userId, userGroupId])
  @@index([userGroupId])
}

model PermissionGrant {
  id          String    @id
  userGroupId String
  permission  String
  scopeKey    String
  eventId     String?
  userGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)
  event       Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([userGroupId, permission, scopeKey])
  @@index([eventId])
}

model BootstrapChallenge {
  id         String    @id
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([expiresAt])
}

enum ServiceAccountStatus {
  active
  disabled
}

/// A non-human machine principal. It is intentionally not a User and cannot join user groups.
model ServiceAccount {
  id               String                          @id
  name             String
  description      String?
  status           ServiceAccountStatus            @default(active)
  version          Int                             @default(1)
  createdByUserId  String?
  createdBy        DomainUser?                     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  permissionGrants ServiceAccountPermissionGrant[]
  apiKeys          ApiKey[]
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@index([createdAt, id])
}

model ServiceAccountPermissionGrant {
  id               String         @id
  serviceAccountId String
  permission       String
  scopeKey         String
  eventId          String?
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  event            Event?         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([serviceAccountId, permission, scopeKey])
  @@index([eventId])
}

/// Stores only safe metadata and a SHA-256 digest of the random key secret, never the bearer value.
model ApiKey {
  id               String         @id
  serviceAccountId String
  name             String
  publicKeyId      String         @unique
  secretHash       String
  expiresAt        DateTime?
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  createdByUserId  String?
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  createdBy        DomainUser?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime       @default(now())

  @@index([serviceAccountId, createdAt, id])
}

enum AuditActorType {
  user
  service_account
  anonymous
  system
}

enum AuditResult {
  success
  failure
}

/// Append-only record of security-relevant actions. Never store secrets or their hashes here.
model AuditEvent {
  id         String         @id
  occurredAt DateTime       @default(now())
  actorType  AuditActorType
  actorId    String?
  action     String
  targetType String
  targetId   String?
  result     AuditResult
  traceId    String?
  metadata   Json?

  @@index([occurredAt, id])
  @@index([targetType, targetId])
}

/// Event-owned participant role such as `participant`. Never an authorization group.
model EventRole {
  id          String        @id
  eventId     String
  name        String
  slug        String
  description String?
  version     Int           @default(1)
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members     EventMember[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([eventId, slug])
  @@index([eventId, createdAt, id])
}

/// Event-owned tactical/provisioning group such as `bravo`. Never grants permissions.
model EventGroup {
  id          String        @id
  eventId     String
  name        String
  slug        String
  description String?
  version     Int           @default(1)
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  members     EventMember[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([eventId, slug])
  @@index([eventId, createdAt, id])
}

/// Provider-neutral external identifier such as a Discord user ID. Never a login method.
model ExternalIdentity {
  id         String     @id
  provider   String
  externalId String
  /// Username last reported by the integration; untrusted display data.
  username   String
  userId     String
  user       DomainUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([provider, externalId])
  @@index([userId])
}

/// Participation of one user in one event with exactly one event role and one event group.
model EventMember {
  id           String     @id
  eventId      String
  userId       String
  eventRoleId  String
  eventGroupId String
  version      Int        @default(1)
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         DomainUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Restrict: assigned roles and groups cannot be deleted until members are reassigned.
  eventRole    EventRole  @relation(fields: [eventRoleId], references: [id], onDelete: Restrict)
  eventGroup   EventGroup @relation(fields: [eventGroupId], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([eventId, userId])
  @@index([eventId, createdAt, id])
  @@index([eventRoleId])
  @@index([eventGroupId])
}

enum SyncIssueStatus {
  open
  resolved
}

/// A synchronization that could not resolve exactly one event role and group. It carries no secrets.
model SyncIssue {
  id             String          @id
  eventId        String
  provider       String
  externalId     String
  status         SyncIssueStatus @default(open)
  username       String
  requestedRole  String
  requestedGroup String
  /// Validated list of { field, code, message } explaining why resolution failed.
  reasons        Json
  occurrences    Int             @default(1)
  resolvedAt     DateTime?
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([eventId, provider, externalId])
  @@index([eventId, createdAt, id])
}
