generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum EventStatus {
  draft
  active
  archived
}

model Event {
  id        String      @id
  name      String
  slug      String      @unique
  timeZone  String
  status    EventStatus @default(draft)
  version   Int         @default(1)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}
