{
	"openapi": "3.0.0",
	"components": {
		"examples": {},
		"headers": {},
		"parameters": {},
		"requestBodies": {},
		"responses": {},
		"schemas": {
			"SetupResponse": {
				"properties": {
					"user": {
						"properties": {
							"email": {
								"type": "string"
							},
							"name": {
								"type": "string"
							},
							"id": {
								"type": "string"
							}
						},
						"required": [
							"email",
							"name",
							"id"
						],
						"type": "object"
					}
				},
				"required": [
					"user"
				],
				"type": "object",
				"additionalProperties": false
			},
			"SetupRequest": {
				"properties": {
					"email": {
						"type": "string",
						"format": "email"
					},
					"name": {
						"type": "string",
						"minLength": 1,
						"maxLength": 100
					},
					"password": {
						"type": "string",
						"minLength": 12,
						"maxLength": 128
					},
					"token": {
						"type": "string",
						"minLength": 48,
						"maxLength": 128
					}
				},
				"required": [
					"email",
					"name",
					"password",
					"token"
				],
				"type": "object",
				"additionalProperties": false
			},
			"HealthResponse": {
				"properties": {
					"status": {
						"type": "string",
						"enum": [
							"ok"
						],
						"nullable": false
					},
					"service": {
						"type": "string",
						"enum": [
							"openmeshtak"
						],
						"nullable": false
					},
					"timestamp": {
						"type": "string"
					}
				},
				"required": [
					"status",
					"service",
					"timestamp"
				],
				"type": "object",
				"additionalProperties": false
			}
		},
		"securitySchemes": {
			"sessionCookie": {
				"type": "apiKey",
				"in": "cookie",
				"name": "openmeshtak.session_token"
			}
		}
	},
	"info": {
		"title": "OpenMeshTak Core API",
		"version": "0.1.0",
		"description": "Authoritative API for OpenMeshTak provisioning and mission distribution.",
		"license": {
			"name": "AGPL-3.0-only"
		},
		"contact": {}
	},
	"paths": {
		"/setup": {
			"post": {
				"operationId": "CreateAdministrator",
				"responses": {
					"201": {
						"description": "Administrator created",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/SetupResponse"
								}
							}
						}
					}
				},
				"description": "Creates the first password-backed administrator using the one-time operator token.",
				"tags": [
					"Setup"
				],
				"security": [],
				"parameters": [],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/SetupRequest"
							}
						}
					}
				}
			}
		},
		"/health": {
			"get": {
				"operationId": "GetHealth",
				"responses": {
					"200": {
						"description": "Healthy",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/HealthResponse"
								}
							}
						}
					}
				},
				"description": "Reports that the API process completed startup, including its database connection.",
				"tags": [
					"Operations"
				],
				"security": [],
				"parameters": []
			}
		}
	},
	"servers": [
		{
			"url": "/api/v1"
		}
	]
}